# SMTP Configuration
# Use 'django.core.mail.backends.smtp.EmailBackend' for production (real emails)
# Use 'django.core.mail.backends.console.EmailBackend' for development (prints to terminal)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# Google Gmail SMTP Settings
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=1

# Your Google Account Email
EMAIL_HOST_USER=your-email@gmail.com

# Your Google App Password (16 characters, no spaces if possible, generate at myaccount.google.com/apppasswords)
EMAIL_HOST_PASSWORD=abcd efgh ijkl mnop

# Default Sender Name
DEFAULT_FROM_EMAIL=Exam-E Admin <23052199@kiit.ac.in>
